NIM_API_KEY=your_real_nvidia_key
NIM_API_BASE=https://integrate.api.nvidia.com/v1
SHOW_REASONING=true
CLEAR_THINKING=true
REASONING_EFFORT=low
ENABLE_THINKING_MODE=true
INCLUDE_RAW_NIM_MODELS=true
REQUEST_TIMEOUT_MS=120000
DEBUG=false

# Optional second provider
NUMES_API_KEY=your_numes_key
NUMES_API_BASE=https://api.numes.ai/api/v1

# Enable only for clients that need structured reasoning state
PRESERVE_REASONING_DETAILS=false

# Optional Numes GLM override; otherwise uses REASONING_EFFORT, then high
# NUMES_REASONING_EFFORT=high
